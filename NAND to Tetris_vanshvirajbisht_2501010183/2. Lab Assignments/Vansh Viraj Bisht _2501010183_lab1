// 16-bit Ripple Carry Adder 
module full_adder( 
input a, b, cin, 
output sum, cout 
); 
assign sum = a ^ b ^ cin; 
assign cout = (a & b) | (b & cin) | (a & cin); 
endmodule 
module ripple_carry_adder_16bit( 
input [15:0] A, B, 
input Cin, 
output [15:0] Sum, 
output Cout, 
output Overflow 
); 
wire [16:0] C; 
assign C[0] = Cin; 
genvar i; 
generate 
for(i = 0; i < 16; i = i + 1) begin 
full_adder FA( 
.a(A[i]), 
.b(B[i]), 
.cin(C[i]), 
.sum(Sum[i]), 
.cout(C[i+1]) 
); 
end 
endgenerate 
assign Cout = C[16]; 
assign Overflow = C[15] ^ C[16]; 
endmodule 
