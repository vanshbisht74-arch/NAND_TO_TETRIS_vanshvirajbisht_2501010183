Q2. Q-3 (6 marks) 
 module RegisterFile( 
    input clk,we, 
    input [2:0] waddr,raddr, 
    input [15:0] din, 
    output [15:0] dout 
); 
    reg [15:0] mem[0:7]; 
 
    always @(posedge clk) 
        if(we) 
            mem[waddr] <= din; 
 
    assign dout = mem[raddr]; 
endmodule 
 
module Testbench; 
    reg clk,we; 
    reg [2:0] waddr,raddr; 
    reg [15:0] din; 
    wire [15:0] dout; 
 
    RegisterFile RF(clk,we,waddr,raddr,din,dout); 
 
    always #5 clk=~clk; 
 
    integer i,j; 
 
    initial begin 
        clk=0; 
        we=1; 
 
        for(i=0;i<4;i=i+1) begin 
            @(negedge clk); 
            waddr=i; 
            din=16'h1000+i; 
 
            @(posedge clk); 
            #1; 
            $display("\nAfter writing R[%0d]",i); 
 
            for(j=0;j<8;j=j+1) 
                $display("R[%0d]=%h",j,RF.mem[j]); 
        end 
 
        we=0; 
 
        for(i=0;i<4;i=i+1) begin 
            raddr=i; 
            #1; 
            $display("Read R[%0d]=%h",raddr,dout); 
        end 
 
        $finish; 
    end 
endmodule 
 
