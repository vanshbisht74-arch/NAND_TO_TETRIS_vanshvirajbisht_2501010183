module RAM8( 
    input clk,we, 
    input [2:0] addr, 
    input [15:0] din, 
    output [15:0] dout 
); 
    wire [15:0] q[0:7]; 
 
    genvar i; 
    generate 
        for(i=0;i<8;i=i+1) begin 
            Register16 R( 
                clk,we && (addr==i),din,q[i] 
            ); 
        end 
    endgenerate 
 
    assign dout=q[addr]; 
endmodule 
 
module RAM64( 
    input clk,we, 
    input [5:0] addr, 
    input [15:0] din, 
    output [15:0] dout 
); 
    wire [15:0] q[0:7]; 
 
    genvar i; 
    generate 
        for(i=0;i<8;i=i+1) begin 
            RAM8 R( 
                clk, 
                we && (addr[5:3]==i), 
                addr[2:0], 
                din, 
                q[i] 
            ); 
        end 
    endgenerate 
 
    assign dout=q[addr[5:3]]; 
endmodule 
 
